{
  "name": "adventurers-inn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/llm tests/engine.test.ts tests/pathfinding.test.ts tests/collision.test.ts tests/supply-crisis.test.ts tests/supply-cycles.test.ts tests/animation.test.ts tests/movement.test.ts && node --test server/llm.test.mjs",
    "test:e2e": "playwright test",
    "test:pages": "vite build --base=/test-repo/ && playwright test --config=playwright.pages.config.ts",
    "validate:sim": "tsx scripts/validate-sim.ts",
    "llm:server": "node server/llm.mjs",
    "validate:endless": "tsx scripts/validate-endless.ts"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
